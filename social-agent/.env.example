# ==============================================================================
# KUCING KEPO ($KEPO / $NOSEY) AUTONOMOUS SOCIAL AGENT - CONFIGURATION
# ==============================================================================

# 1. TELEGRAM BOT CREDENTIALS
# Get your token from https://t.me/BotFather via /newbot command
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Telegram Group ID where the bot will engage (e.g. -1001234567890)
# (Add the bot to your group as Admin, then invite member or send a message to see ID)
TELEGRAM_GROUP_ID=your_telegram_group_id_here

# Your Personal Telegram User ID (Used to restrict executive admin commands: /status, /set_phase, /set_directive)
# You can find your ID from https://t.me/userinfobot
ADMIN_TELEGRAM_ID=your_personal_telegram_user_id

# 2. GOOGLE GEMINI AI CONFIGURATION
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. TOKEN & PROJECT INFO
TOKEN_NAME=Nosey Cat
TOKEN_TICKER=$NOSEY
TOKEN_TICKER_ALT=$KEPO
SOLANA_TOKEN_CA=COMING_SOON_ON_PUMPFUN
WEBSITE_URL=https://jonihaha100.github.io/nosey-cat/
TELEGRAM_PORTAL_URL=https://t.me/TheNoseyCat
TWITTER_URL=https://x.com/TheNoseyCat

# 4. BUSINESS & IDLE AGENT BEHAVIOR
# Options: PRE_LAUNCH | LIVE_LAUNCH | COMMUNITY_HOLD
DEFAULT_BUSINESS_PHASE=PRE_LAUNCH

# Idle Chime-In interval: minutes of group inactivity before Kucing Kepo throws a witty joke/meme
IDLE_CHIME_MINUTES=30

# 5. X (TWITTER) API V2 CREDENTIALS (OPTIONAL - If omitted, tweets are sent to Admin Telegram for 1-Click Post)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
